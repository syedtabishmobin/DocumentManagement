{
  "name": "@document-management/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "persistence:migrate": "tsx src/persistence.cli.ts migrate",
    "persistence:import-local": "tsx src/persistence.cli.ts import-local-synthetic",
    "persistence:verify": "tsx src/persistence.cli.ts verify",
    "notification:transport": "tsx src/notification-email.cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/identity": "^4.13.2",
    "@azure/monitor-query-logs": "^1.0.0",
    "@azure/storage-blob": "^12.33.0",
    "@document-management/contracts": "workspace:*",
    "@document-management/domain": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "express": "^5.2.1",
    "jose": "^6.2.10",
    "multer": "^2.0.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
