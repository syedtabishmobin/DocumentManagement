{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVT-P1-003 Subject record changed v1",
  "allOf": [
    {
      "$ref": "../common/event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "EVT-P1-003"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "scope_kind": {
          "const": "WORKSPACE"
        },
        "aggregate_type": {
          "const": "Workspace"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject_id",
            "subject_revision",
            "change_kind",
            "reason_code"
          ],
          "properties": {
            "subject_id": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "subject_revision": {
              "type": "integer",
              "minimum": 1
            },
            "change_kind": {
              "type": "string",
              "enum": [
                "CREATED",
                "ATTRIBUTES_CHANGED",
                "RELATIONSHIP_AUTHORITY_CHANGED",
                "STATUS_CHANGED"
              ]
            },
            "reason_code": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeReasonCode"
            }
          }
        }
      }
    }
  ]
}
