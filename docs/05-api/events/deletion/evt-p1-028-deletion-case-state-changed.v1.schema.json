{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVT-P1-028 DeletionCase state changed v1",
  "allOf": [
    {
      "$ref": "../common/event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "EVT-P1-028"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "scope_kind": {
          "const": "WORKSPACE"
        },
        "aggregate_type": {
          "const": "DeletionCase"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deletion_scope_ref",
            "from_state",
            "to_state",
            "fence_generation",
            "deletion_plan_ref",
            "residual_state",
            "reason_code"
          ],
          "properties": {
            "deletion_scope_ref": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "from_state": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/nullableSafeState"
            },
            "to_state": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeState"
            },
            "fence_generation": {
              "type": "integer",
              "minimum": 0
            },
            "deletion_plan_ref": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "residual_state": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeState"
            },
            "reason_code": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeReasonCode"
            }
          }
        }
      }
    }
  ]
}
