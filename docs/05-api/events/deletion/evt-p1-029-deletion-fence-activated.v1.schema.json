{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVT-P1-029 Deletion fence activated v1",
  "allOf": [
    {
      "$ref": "../common/event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "EVT-P1-029"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "scope_kind": {
          "const": "WORKSPACE"
        },
        "aggregate_type": {
          "const": "DeletionCase"
        },
        "deletion_fence": {
          "properties": {
            "state": {
              "const": "FENCED"
            }
          }
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fence_generation",
            "deletion_scope_ref",
            "fence_state",
            "effective_at",
            "blocked_data_role_classes"
          ],
          "properties": {
            "fence_generation": {
              "type": "integer",
              "minimum": 1
            },
            "deletion_scope_ref": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "fence_state": {
              "const": "FENCED"
            },
            "effective_at": {
              "type": "string",
              "format": "date-time"
            },
            "blocked_data_role_classes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeState"
              }
            }
          }
        }
      }
    }
  ]
}
