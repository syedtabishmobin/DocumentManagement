{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVT-P1-012 FactOccurrence recorded v1",
  "allOf": [
    {
      "$ref": "../common/event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "EVT-P1-012"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "scope_kind": {
          "const": "WORKSPACE"
        },
        "aggregate_type": {
          "const": "CanonicalFact"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fact_occurrence_id",
            "fact_definition_version",
            "subject_or_entity_ref",
            "source_kind",
            "evidence_anchor_refs",
            "asserted_valid_time_ref",
            "review_state"
          ],
          "properties": {
            "fact_occurrence_id": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "fact_definition_version": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "subject_or_entity_ref": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "source_kind": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeState"
            },
            "evidence_anchor_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
              }
            },
            "asserted_valid_time_ref": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "review_state": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeState"
            }
          }
        }
      }
    }
  ]
}
