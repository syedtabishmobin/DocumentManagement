{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVT-P1-024 EvidenceVerification recorded v1",
  "allOf": [
    {
      "$ref": "../common/event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "EVT-P1-024"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "scope_kind": {
          "const": "WORKSPACE"
        },
        "aggregate_type": {
          "const": "RequirementCase"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_verification_id",
            "evidence_submission_id",
            "criterion_version",
            "outcome",
            "verifier_decision_ref",
            "evidence_anchor_refs",
            "reason_code"
          ],
          "properties": {
            "evidence_verification_id": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "evidence_submission_id": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "criterion_version": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "outcome": {
              "type": "string",
              "enum": [
                "VERIFIED",
                "REJECTED",
                "INSUFFICIENT",
                "CONFLICTED",
                "RESTRICTED",
                "EXPIRED"
              ]
            },
            "verifier_decision_ref": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "evidence_anchor_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
              }
            },
            "reason_code": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeReasonCode"
            }
          }
        }
      }
    }
  ]
}
