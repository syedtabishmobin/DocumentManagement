{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVT-P1-022 Approval state changed v1",
  "allOf": [
    {
      "$ref": "../common/event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "EVT-P1-022"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "scope_kind": {
          "const": "WORKSPACE"
        },
        "aggregate_type": {
          "const": "Approval"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from_state",
            "to_state",
            "approval_decision",
            "reviewed_input_digest_ref",
            "effect_digest_ref",
            "target_resource_ref",
            "target_revision",
            "reason_code"
          ],
          "properties": {
            "from_state": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/nullableSafeState"
            },
            "to_state": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeState"
            },
            "approval_decision": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeState"
            },
            "reviewed_input_digest_ref": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "effect_digest_ref": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "target_resource_ref": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "target_revision": {
              "type": "integer",
              "minimum": 0
            },
            "reason_code": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeReasonCode"
            }
          }
        }
      }
    }
  ]
}
