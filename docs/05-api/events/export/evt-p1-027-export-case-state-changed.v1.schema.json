{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVT-P1-027 ExportCase state changed v1",
  "allOf": [
    {
      "$ref": "../common/event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "EVT-P1-027"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "scope_kind": {
          "const": "WORKSPACE"
        },
        "aggregate_type": {
          "const": "ExportCase"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest_version",
            "from_state",
            "to_state",
            "scope_snapshot_ref",
            "authorization_snapshot_ref",
            "item_manifest_ref",
            "checksum_manifest_ref",
            "exclusion_codes",
            "reason_code"
          ],
          "properties": {
            "manifest_version": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "from_state": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/nullableSafeState"
            },
            "to_state": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeState"
            },
            "scope_snapshot_ref": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "authorization_snapshot_ref": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "item_manifest_ref": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/nullableSafeRef"
            },
            "checksum_manifest_ref": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/nullableSafeRef"
            },
            "exclusion_codes": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeReasonCode"
              }
            },
            "reason_code": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeReasonCode"
            }
          }
        }
      }
    }
  ]
}
