{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVT-P1-006 IngestionCase state changed v1",
  "allOf": [
    {
      "$ref": "../common/event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "EVT-P1-006"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "scope_kind": {
          "const": "WORKSPACE"
        },
        "aggregate_type": {
          "const": "IngestionCase"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transition_id",
            "stage_id",
            "from_state",
            "to_state",
            "reason_code",
            "attempt",
            "publication_checkpoint_ref",
            "artifact_id"
          ],
          "properties": {
            "transition_id": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "stage_id": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "from_state": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/nullableSafeState"
            },
            "to_state": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeState"
            },
            "reason_code": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeReasonCode"
            },
            "attempt": {
              "type": "integer",
              "minimum": 1
            },
            "publication_checkpoint_ref": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "artifact_id": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/nullableSafeRef"
            }
          }
        }
      }
    }
  ]
}
