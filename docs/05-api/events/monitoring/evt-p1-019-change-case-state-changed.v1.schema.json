{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVT-P1-019 ChangeCase state changed v1",
  "allOf": [
    {
      "$ref": "../common/event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "EVT-P1-019"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "scope_kind": {
          "const": "WORKSPACE"
        },
        "aggregate_type": {
          "const": "ChangeCase"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_observation_id",
            "trigger_occurrence_id",
            "comparison_ref",
            "change_outcome",
            "from_state",
            "to_state",
            "evidence_anchor_refs"
          ],
          "properties": {
            "source_observation_id": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "trigger_occurrence_id": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "comparison_ref": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "change_outcome": {
              "type": "string",
              "enum": [
                "SUPPORTED_CHANGE",
                "SUPPORTED_NO_CHANGE_WITHIN_SCOPE",
                "INDETERMINATE",
                "REVIEW_REQUIRED"
              ]
            },
            "from_state": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/nullableSafeState"
            },
            "to_state": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeState"
            },
            "evidence_anchor_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
              }
            }
          }
        }
      }
    }
  ]
}
