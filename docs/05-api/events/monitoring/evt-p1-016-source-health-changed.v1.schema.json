{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVT-P1-016 SourceHealth changed v1",
  "allOf": [
    {
      "$ref": "../common/event-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "EVT-P1-016"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "scope_kind": {
          "enum": [
            "WORKSPACE",
            "GLOBAL_REFERENCE"
          ]
        },
        "aggregate_type": {
          "const": "SourceHealth"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_definition_version",
            "from_health_state",
            "to_health_state",
            "last_attempt_ref",
            "last_success_observation_id",
            "freshness_state",
            "coverage_state",
            "reason_code"
          ],
          "properties": {
            "source_definition_version": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "from_health_state": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/nullableSafeState"
            },
            "to_health_state": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeState"
            },
            "last_attempt_ref": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeRef"
            },
            "last_success_observation_id": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/nullableSafeRef"
            },
            "freshness_state": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeState"
            },
            "coverage_state": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeState"
            },
            "reason_code": {
              "$ref": "../common/event-envelope.v1.schema.json#/$defs/safeReasonCode"
            }
          }
        }
      }
    }
  ]
