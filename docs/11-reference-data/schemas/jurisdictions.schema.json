{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.document-management.example.invalid/reference-data/v1/jurisdictions.schema.json",
  "x-schema-version": "1.0.0",
  "title": "Phase 1 jurisdiction catalogue",
  "type": "object",
  "required": ["$schema", "pack", "jurisdictions"],
  "properties": {
    "$schema": {"const": "../schemas/jurisdictions.schema.json"},
    "pack": {"$ref": "common.schema.json#/$defs/record"},
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "allOf": [
          {"$ref": "common.schema.json#/$defs/record"},
          {
            "type": "object",
            "properties": {
              "attributes": {
                "type": "object",
                "required": ["code", "kind", "parent_ref", "runtime_enabled", "coverage_claim", "synthetic", "non_production"],
                "properties": {
                  "code": {"type": "string", "minLength": 2},
                  "kind": {"enum": ["REFERENCE_SCOPE", "COUNTRY", "STATE_OR_TERRITORY"]},
                  "parent_ref": {"type": ["string", "null"]},
                  "runtime_enabled": {"const": false},
                  "coverage_claim": {"const": false},
                  "synthetic": {"type": "boolean"},
                  "non_production": {"const": true}
                },
                "additionalProperties": false
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
