{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering-framework.invalid/protocols/work-item.schema.json",
  "title": "Governed work item",
  "type": "object",
  "required": ["id", "type", "title", "outcome", "scope", "acceptanceCriteria", "traceability", "owner", "status"],
  "properties": {
    "id": {"type": "string"},
    "type": {"enum": ["GOAL", "FEATURE", "STORY", "TASK"]},
    "title": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "minLength": 1},
    "scope": {"type": "object", "required": ["in", "out"]},
    "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "criterion", "evidenceRequired"]}},
    "traceability": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "owner": {"type": "string"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["PROPOSED", "READY", "IN_PROGRESS", "BLOCKED", "IN_QA", "DONE"]}
  },
  "additionalProperties": true
}
