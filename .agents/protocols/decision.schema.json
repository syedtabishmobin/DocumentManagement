{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering-framework.invalid/protocols/decision.schema.json",
  "title": "Critical decision record",
  "type": "object",
  "required": ["id", "title", "authority", "status", "question", "evidence", "options", "recommendation", "blockedScope", "continuingWork", "authoritativeUrl"],
  "properties": {
    "id": {"type": "string", "pattern": "^DEC-[A-Z0-9-]+$"},
    "title": {"type": "string"},
    "authority": {"type": "string"},
    "status": {"enum": ["OPEN", "PROPOSED", "APPROVED", "REJECTED", "SUPERSEDED"]},
    "question": {"type": "string"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "options": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id", "description", "impacts"]}},
    "recommendation": {"type": "object", "required": ["optionId", "reason"]},
    "blockedScope": {"type": "array", "items": {"type": "string"}},
    "continuingWork": {"type": "array", "items": {"type": "string"}},
    "authoritativeUrl": {"type": "string", "format": "uri"}
  },
  "additionalProperties": true
}
