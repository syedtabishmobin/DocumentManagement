{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering-framework.invalid/protocols/release-evidence.schema.json",
  "title": "Release and UAT evidence",
  "type": "object",
  "required": ["candidate", "sourceRevision", "artifactDigests", "environment", "deliveredScope", "acceptanceEvidence", "qaStatus", "businessAcceptance", "residualRisks", "accessInstructions", "recommendedUatScenarios", "durableEvidence", "promotionDecision"],
  "properties": {
    "candidate": {"type": "string"},
    "sourceRevision": {"type": "string"},
    "artifactDigests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "environment": {"enum": ["DEV", "STAGE", "PROD"]},
    "deliveredScope": {"type": "array", "items": {"type": "string"}},
    "acceptanceEvidence": {"type": "array", "items": {"type": "string"}},
    "qaStatus": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "businessAcceptance": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_STARTED"]},
    "residualRisks": {"type": "array", "items": {"type": "string"}},
    "accessInstructions": {"type": "string"},
    "recommendedUatScenarios": {"type": "array", "items": {"type": "string"}},
    "durableEvidence": {"type": "array", "items": {"type": "string"}},
    "promotionDecision": {"enum": ["READY_FOR_UAT", "BLOCKED", "APPROVED", "REJECTED"]},
    "productAuthorityApproval": {"type": "object", "required": ["status", "decisionUrl"], "properties": {"status": {"enum": ["APPROVED", "REJECTED", "PENDING"]}, "decisionUrl": {"type": "string", "format": "uri"}}}
  },
  "additionalProperties": true
}
