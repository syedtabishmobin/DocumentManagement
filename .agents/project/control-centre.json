  "freshnessClasses": {
    "LIVE": "Local lifecycle events and active runtime state refreshed from the validated JSONL store.",
    "CURRENT": "GitHub, repository, environment and notification snapshots captured at the displayed time.",
    "HISTORICAL": "Retained events, closed evidence and time-bucketed trends within configured retention."
  },
  "progressMeasures": [
    {
      "id": "story-work-completion",
      "formula": "governed stories in Done / all governed stories in the selected scope",
      "completionBoundary": "A closed task or pull request is not sufficient."
    },
    {
      "id": "acceptance-criteria-completion",
      "formula": "acceptance criteria with current passing independent evidence / all acceptance criteria in the selected scope",
      "completionBoundary": "Unresolved, skipped, stale, or developer-only evidence does not count as passed."
    },
    {
      "id": "feature-work-completion",
      "formula": "governed feature stories in Done / all governed feature stories",
      "completionBoundary": "Separate from feature success-criterion achievement."
    },
    {
      "id": "feature-success-criteria-achievement",
      "formula": "feature success criteria with current measured passing evidence / all feature success criteria",
      "completionBoundary": "No inference from child closure alone."
    },
    {
      "id": "goal-work-completion",
      "formula": "governed goal features in Done / all governed goal features",
      "completionBoundary": "Separate from measurable outcome achievement."
    },
    {
      "id": "goal-success-criteria-achievement",
      "formula": "goal success criteria with current measured passing evidence / all goal success criteria",
      "completionBoundary": "Unavailable or unmeasured outcomes remain unresolved, never zero or complete."
    }
  ],
