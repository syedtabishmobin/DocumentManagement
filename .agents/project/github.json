{
  "schemaVersion": "1.0.0",
  "repository": "syedtabishmobin/DocumentManagement",
  "visibility": "public",
  "defaultBranch": "main",
  "issuesEnabled": true,
  "authoritativeWorkAndDecisionChannel": "GITHUB_ISSUES",
  "branchNaming": "codex/<issue>-<short-name>",
  "mergePreference": "SQUASH",
  "deleteBranchOnMergeEnabled": true,
  "requiredWorkflow": "Phase 1 quality gates",
  "requiredChecks": ["specifications-and-typescript", "flutter-android", "flutter-ios-simulator"],
  "pullRequestRequired": true,
  "codeOwnerIdentificationConfigured": true,
  "codeOwnerReviewRequiredForSensitivePaths": false,
  "requiredApprovingReviews": 0,
  "remoteProtection": {
    "observedRules": 1,
    "mechanism": "CLASSIC_BRANCH_PROTECTION",
    "enforcement": "ENABLED_INCLUDING_ADMINISTRATORS",
    "result": "ENFORCED",
    "strictStatusChecks": true,
    "pullRequestRequired": true,
    "linearHistoryRequired": true,
    "conversationResolutionRequired": true,
    "forcePushAllowed": false,
    "branchDeletionAllowed": false,
    "approvedDecision": "DEC-FWK-001:OPTION-B",
    "secondReviewerTransition": "Increase required approving reviews to one and enable required CODEOWNER review when a second authorised reviewer is configured."
  }
}
