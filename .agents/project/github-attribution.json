{
  "schemaVersion": "2.0.0",
  "markerStart": "<!-- doculyra-agent-meta:v2",
  "markerEnd": "-->",
  "legacyMarkers": ["<!-- doculyra-agent-attribution:v1 -->"],
  "format": "VISIBLE_HEADER_THEN_COLLAPSIBLE_DETAILS_THEN_BODY_THEN_HIDDEN_METADATA",
  "identityAssignments": ".agents/state/agent-display-assignments.json",
  "requiredFields": [
    "display_agent_id",
    "display_role",
    "activity",
    "display_run_id",
    "runtime_agent_id",
    "runtime_run_id",
    "role_id",
    "parent_display_agent_id",
    "work_item",
    "work_item_label",
    "capability_ids",
    "skill_ids",
    "tool_ids",
    "commit",
    "environment"
  ],
  "listFields": ["capability_ids", "skill_ids", "tool_ids"],
  "identifierPattern": "^[a-zA-Z0-9][a-zA-Z0-9._:#/-]{1,255}$",
  "displayAgentIdPattern": "^[A-Z][A-Z0-9-]{1,24}-[0-9]{3}$",
  "displayRunIdPattern": "^RUN-[0-9]{8}-[0-9]{4}$",
  "activityPattern": "^[a-z0-9][a-z0-9-]{1,79}$",
  "commitPattern": "^(?:[0-9a-f]{7,40}|PENDING|UNAVAILABLE)$",
  "listSeparator": ",",
  "noParentValue": "NONE",
  "rolePresentations": [
    {"roleId": "delivery-orchestrator", "displayRole": "Framework Delivery Orchestrator", "displayIdPattern": "^ORCH-[0-9]{3}$"},
    {"roleId": "product-ba", "displayRole": "Product Business Analyst", "displayIdPattern": "^BA-[0-9]{3}$"},
    {"roleId": "architecture-guardian", "displayRole": "Architecture Guardian", "displayIdPattern": "^ARCH-[0-9]{3}$"},
    {"roleId": "qa-release-lead", "displayRole": "Independent Functional QA", "displayIdPattern": "^QA-FUNC-[0-9]{3}$"},
    {"roleId": "qa-release-lead", "displayRole": "Independent Security QA", "displayIdPattern": "^QA-SEC-[0-9]{3}$"},
    {"roleId": "qa-release-lead", "displayRole": "Independent End-to-End QA", "displayIdPattern": "^QA-E2E-[0-9]{3}$"},
    {"roleId": "qa-release-lead", "displayRole": "Independent AI Evaluator", "displayIdPattern": "^AI-EVAL-[0-9]{3}$"},
    {"roleId": "repository-steward", "displayRole": "Repository Steward", "displayIdPattern": "^SEC-[0-9]{3}$"},
    {"roleId": "agent-operations-lead", "displayRole": "Agent Operations Lead", "displayIdPattern": "^OPS-[0-9]{3}$"}
  ],
  "appliesTo": [
    "agent-authored material GitHub Issues and comments",
    "agent-authored defects and fix-ready updates",
    "agent-authored pull request descriptions and reviews",
    "agent-authored QA results and independent retests",
    "agent-authored architecture and security decisions",
    "agent-authored Product Authority decision requests",
    "agent-authored UAT-ready records and release evidence"
  ],
  "humanAuthoredRecordsRequireAttribution": false
}
