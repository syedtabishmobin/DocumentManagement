{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-engineering-framework.invalid/observability/event.schema.json",
  "title": "Agent operations event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "eventType", "occurredAt", "projectId", "runId", "agentId", "state", "dataClassification"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "eventId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{2,127}$"},
    "eventType": {"enum": ["AGENT_STARTED", "AGENT_COMPLETED", "AGENT_FAILED", "AGENT_BLOCKED", "AGENT_STATE_CHANGED", "SUBAGENT_SPAWNED", "HANDOFF_CREATED", "WORK_ITEM_STARTED", "WORK_ITEM_COMPLETED", "CAPABILITY_SELECTED", "SKILL_STARTED", "SKILL_COMPLETED", "SKILL_FAILED", "TOOL_STARTED", "TOOL_COMPLETED", "TOOL_FAILED", "TEST_STARTED", "TEST_PASSED", "TEST_FAILED", "DEFECT_CREATED", "DEFECT_FIX_READY", "DEFECT_RETEST_PASSED", "DEFECT_RETEST_FAILED", "QUALITY_GATE_PASSED", "QUALITY_GATE_FAILED", "HUMAN_DECISION_REQUIRED", "HUMAN_DECISION_RESOLVED", "ENVIRONMENT_PROMOTED", "UAT_READY", "RETRY_RECORDED", "NOTIFICATION_STATUS_CHANGED", "USAGE_RECORDED", "CONTEXT_OBSERVED"]},
    "occurredAt": {"type": "string", "format": "date-time"},
    "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "runId": {"type": "string", "minLength": 3, "maxLength": 128},
    "agentId": {"type": "string", "minLength": 3, "maxLength": 128},
    "parentAgentId": {"type": "string", "minLength": 3, "maxLength": 128},
    "roleId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "modelProfile": {"type": "string", "maxLength": 80},
    "goalId": {"type": "string", "maxLength": 80},
    "featureId": {"type": "string", "maxLength": 80},
    "workItem": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["GOAL", "FEATURE", "STORY", "TASK", "BUG", "DECISION", "RELEASE"]},
        "id": {"type": "string", "maxLength": 80},
        "url": {"type": "string", "maxLength": 300}
      }
    },
    "capabilityIds": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"}},
    "skillIds": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"}},
    "toolIds": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"}},
    "adapterIds": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"}},
    "branch": {"type": "string", "maxLength": 160},
    "worktree": {"type": "string", "maxLength": 300},
    "pullRequest": {
      "type": "object", "additionalProperties": false, "required": ["number", "url"],
      "properties": {"number": {"type": "integer", "minimum": 1}, "url": {"type": "string", "maxLength": 300}}
    },
    "environmentId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "releaseCandidateId": {"type": "string", "maxLength": 100},
    "state": {"enum": ["STARTING", "RUNNING", "TESTING", "BLOCKED", "HANDOFF", "COMPLETED", "FAILED", "IDLE", "NOT_APPLICABLE"]},
    "durationMs": {"type": "integer", "minimum": 0},
    "retryCount": {"type": "integer", "minimum": 0},
    "handoffTargetAgentId": {"type": "string", "maxLength": 128},
    "blocker": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "status"],
      "properties": {
        "kind": {"enum": ["HUMAN_DECISION", "DEFECT", "DEPENDENCY", "ENVIRONMENT", "PERMISSION", "EXTERNAL_ACTION"]},
        "id": {"type": "string", "maxLength": 100},
        "status": {"enum": ["OPEN", "RESOLVED"]},
        "url": {"type": "string", "maxLength": 300}
      }
    },
    "quality": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "gateId": {"type": "string", "maxLength": 100},
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE", "PENDING"]},
        "acceptanceCriterionId": {"type": "string", "maxLength": 100},
        "defectId": {"type": "string", "maxLength": 100},
        "reworkCycle": {"type": "integer", "minimum": 0}
      }
    },
    "notification": {
      "type": "object", "additionalProperties": false, "required": ["eventKey", "status"],
      "properties": {
        "eventKey": {"type": "string", "maxLength": 180},
        "status": {"enum": ["RESERVED", "SENT", "FAILED", "EXTERNAL_ACTION_REQUIRED"]},
        "authoritativeUrl": {"type": "string", "maxLength": 300}
      }
    },
    "resultCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$"},
    "evidenceUrls": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "maxLength": 300}},
    "usage": {
      "type": "object", "additionalProperties": false, "required": ["recordId", "scope", "inputTokens", "cachedInputTokens", "outputTokens", "reasoningTokens", "totalTokens", "credits", "providerCost", "toolCost"],
      "properties": {
        "recordId": {"type": "string", "maxLength": 128},
        "scope": {"enum": ["SELF_ONLY", "INCLUSIVE"]},
        "inputTokens": {"$ref": "#/$defs/countMetric"},
        "cachedInputTokens": {"$ref": "#/$defs/countMetric"},
        "outputTokens": {"$ref": "#/$defs/countMetric"},
        "reasoningTokens": {"$ref": "#/$defs/countMetric"},
        "totalTokens": {"$ref": "#/$defs/countMetric"},
        "credits": {"$ref": "#/$defs/numberMetric"},
        "providerCost": {"$ref": "#/$defs/costMetric"},
        "toolCost": {"$ref": "#/$defs/costMetric"}
      }
    },
    "contextEfficiency": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "filesLoaded": {"$ref": "#/$defs/countMetric"},
        "unchangedFilesReloaded": {"$ref": "#/$defs/countMetric"},
        "largeOutputBytes": {"$ref": "#/$defs/countMetric"},
        "discoveryScans": {"$ref": "#/$defs/countMetric"},
        "contextReuseRatio": {"$ref": "#/$defs/ratioMetric"},
        "cacheRatio": {"$ref": "#/$defs/ratioMetric"}
      }
    },
    "dataClassification": {"const": "OPERATIONAL_METADATA"},
    "synthetic": {"type": "boolean"}
  },
  "$defs": {
    "provenance": {"enum": ["MEASURED", "PROVIDER_REPORTED", "ATTRIBUTED", "ESTIMATED", "UNAVAILABLE"]},
    "countMetric": {"type": "object", "additionalProperties": false, "required": ["value", "provenance"], "properties": {"value": {"type": ["integer", "null"], "minimum": 0}, "provenance": {"$ref": "#/$defs/provenance"}}},
    "numberMetric": {"type": "object", "additionalProperties": false, "required": ["value", "provenance"], "properties": {"value": {"type": ["number", "null"], "minimum": 0}, "provenance": {"$ref": "#/$defs/provenance"}}},
    "ratioMetric": {"type": "object", "additionalProperties": false, "required": ["value", "provenance"], "properties": {"value": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "provenance": {"$ref": "#/$defs/provenance"}}},
    "costMetric": {"type": "object", "additionalProperties": false, "required": ["value", "currency", "provenance"], "properties": {"value": {"type": ["number", "null"], "minimum": 0}, "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"}, "provenance": {"$ref": "#/$defs/provenance"}}}
  }
}
