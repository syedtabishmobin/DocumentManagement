# Local-only defaults. Do not put real credentials in this file.
DM_PROFILE=local
DM_API_PORT=4310
DM_WEB_ORIGIN=http://localhost:4173
DM_DATA_DIR=./local-data
DM_OUTBOUND_NETWORK=deny
DM_AI_PROVIDER=local-deterministic
DM_EXTERNAL_CONNECTORS=disabled
DM_EXTERNAL_NOTIFICATIONS=disabled

# Public website. Set this only to an address on a domain you control.
VITE_CONTACT_EMAIL=
DM_PUBLIC_BASE_URL=

# Managed customer identity (approved production target: Microsoft Entra External ID).
DM_IDENTITY_PROVIDER=unconfigured
DM_ENTRA_EXTERNAL_TENANT_ID=
DM_ENTRA_EXTERNAL_CLIENT_ID=
DM_ENTRA_EXTERNAL_CLIENT_SECRET=

# Direct provider applications. Never expose client secrets to Vite/browser variables.
# Azure dev Key Vault references are documented in docs/09-devops/08-external-provider-setup.md.
DM_GOOGLE_CLIENT_ID=
DM_GOOGLE_CLIENT_SECRET=
DM_GOOGLE_CLIENT_SECRET_CONFIGURED=false
DM_MICROSOFT_CLIENT_ID=
DM_MICROSOFT_CLIENT_SECRET=
DM_MICROSOFT_CLIENT_SECRET_CONFIGURED=false
DM_MICROSOFT_TENANT=common
DM_APPLE_TEAM_ID=
DM_APPLE_SERVICE_ID=
DM_APPLE_KEY_ID=
DM_APPLE_PRIVATE_KEY_PATH=

# Document-source provider applications.
DM_DROPBOX_APP_KEY=
DM_DROPBOX_APP_SECRET=
DM_DROPBOX_APP_SECRET_CONFIGURED=false
DM_BOX_CLIENT_ID=
DM_BOX_CLIENT_SECRET=
DM_BOX_CLIENT_SECRET_CONFIGURED=false
DM_INBOUND_EMAIL_DOMAIN=
DM_EMAIL_WEBHOOK_SECRET=

# Invitation delivery. Provider selection and sender identities require approval.
DM_EMAIL_PROVIDER=unconfigured
DM_EMAIL_API_KEY=
DM_EMAIL_FROM=
DM_AZURE_COMMUNICATION_SERVICE=
DM_AZURE_COMMUNICATION_ENDPOINT=
DM_SMS_PROVIDER=unconfigured
DM_SMS_ACCOUNT_ID=
DM_SMS_AUTH_TOKEN=
DM_SMS_SENDER=

# These gates remain false until adapter conformance, consent, callback, token protection,
# revocation/deletion, privacy/residency and external-delivery tests pass.
DM_CONNECTOR_ADAPTERS_READY=false
